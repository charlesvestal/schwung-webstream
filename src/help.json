{
  "title": "Webstream",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Web audio search",
        "and streaming.",
        "",
        "Search and play",
        "audio from YouTube,",
        "FreeSound, Archive,",
        "and SoundCloud.",
        "",
        "Requires internet",
        "connection."
      ]
    },
    {
      "title": "Controls",
      "children": [
        {
          "title": "Playback Knobs",
          "lines": [
            "Knobs, on every page",
            "and in the chain",
            "editor:",
            " 1 Play/Pause",
            " 2 Back 15s",
            " 3 Forward 15s",
            " 4 Gain",
            " 5 Stop",
            " 6 Restart",
            "Turn to fire."
          ]
        },
        {
          "title": "Searching",
          "lines": [
            "Page 1 is Browse.",
            "Click to enter it;",
            "Back goes up a",
            "level, then out.",
            "",
            "Search [YT]: opens",
            "the keyboard.",
            "Provider: pick the",
            "source (YouTube,",
            "FreeSound, Archive,",
            "SoundCloud, Crate",
            "Dig).",
            "Results follow the",
            "menu rows; click one",
            "to play it.",
            "Previous searches",
            "and Favorites are",
            "lists to pick from.",
            "Now playing: details,",
            "favorite, and",
            "download to Wave",
            "Edit."
          ]
        },
        {
          "title": "Crate Dig",
          "lines": [
            "Random music",
            "discovery powered",
            "by Discogs.",
            "",
            "Filter by genre,",
            "style, decade, and",
            "country. Hit [Dig!]",
            "for random tracks.",
            "",
            "Finds releases on",
            "Discogs with YouTube",
            "videos and plays",
            "them directly.",
            "",
            "Uses Discogs API.",
            "Optional: add your",
            "own token for higher",
            "rate limits (60/min",
            "vs 25/min).",
            "",
            "Add token under",
            "Discogs Token on the",
            "Webstream page in the",
            "Schwung manager.",
            "",
            "Get a free token at",
            "discogs.com/settings",
            "/developers"
          ]
        }
      ]
    },
    {
      "title": "Playback",
      "lines": [
        "Select a result to",
        "start streaming.",
        "",
        "Status indicator:",
        " Loading: resolving",
        " Buffering: filling",
        " Streaming: playing",
        " Paused: paused",
        " Seeking: skipping",
        "",
        "Gain: 0-2x output",
        "level.",
        "",
        "60-second ring",
        "buffer prevents",
        "audio dropouts."
      ]
    }
  ]
}
